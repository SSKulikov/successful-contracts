  "scripts": {
    "start": "npm run build && NODE_TLS_REJECT_UNAUTHORIZED=0 node ./dist/index.js",
    "build": "tsc",
    "format": "prettier --config .prettierrc --write \"src/**/*.{js,ts}\"",
    "prisma-migrate": "prisma migrate dev --name название_миграции --schema=src/prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "prisma-migrate-deploy": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "prisma-generate": "prisma generate --schema=src/prisma/schema.prisma",
    "prisma-studio": "prisma studio --schema=src/prisma/schema.prisma",
    "test": "tsx --test src/utils/parse-approver-employee-ids.test.ts src/utils/parse-pipeline-cache-key.test.ts",
    "test:e2e": "tsx scripts/staging-e2e.ts"
  },
  "keywords": [],
