DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/docflow"

# Storage
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET_RAW=contracts-raw
S3_BUCKET_PROCESSED=contracts-processed
S3_ACCESS_KEY_ID=__SET_ME__
S3_SECRET_ACCESS_KEY=__SET_ME__
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_UPLOAD_TTL_SEC=900
S3_PRESIGNED_DOWNLOAD_TTL_SEC=900

# Parser limits
PARSER_MAX_FILE_MB=30
PARSER_JOB_TIMEOUT_MS=120000

# Подпись JWT (обязательно в production). В dev допустимо не задавать — используется запасной секрет.
# JWT_SECRET="openssl rand -hex 32"
# Срок жизни access-токена (например 7d, 24h). По умолчанию: 7d
# JWT_EXPIRES_IN="7d"
# Origin фронта (Vite), без завершающего слэша. Несколько значений через запятую.
# Если не задано — API разрешает любой origin (удобно для локальной разработки).
# Несколько origin через запятую (например Vite :5173 и :3000).
# CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
# Optional. Kept for reference, not used in current runtime.
DATABASE_NAME="AlternativaGames"
# Optional. Used only by legacy YaGptService.
OAUTH_TOKEN=""
GIGA_CHAT_ACCESS_KEY=""
# LLM provider for parse-file pipeline: gigachat (default) or yagpt
# LLM_PROVIDER="gigachat"
# Required for YaGptService when LLM_PROVIDER=yagpt
# FOLDER_ID=""
# Optional: set pre-generated IAM token instead of OAUTH_TOKEN
# BEARER_TOKEN=""

# Кэш документов и хеш парсинга. На хосте (npm start) — обычно redis://127.0.0.1:6379; в контейнере api из docker-compose задаётся redis://redis:6379.
# REDIS_URL=redis://127.0.0.1:6379

# Кэш полного пайплайна parse-file (OCR / чанки / GigaChat): ключ `{префикс}_{sha256-содержимого-файла}`, значение — JSON после normalize.
# По умолчанию префикс parse:pipeline, TTL 3 суток (259200).
# PARSE_PIPELINE_CACHE_KEY_PREFIX=parse:pipeline
# PARSE_PIPELINE_CACHE_TTL_SECONDS=259200

# Опционально. TTL (секунды) записи SHA-256 нормализованного JSON после LLM в Redis (ключ `parse:norm-sha256:{filename}`). По умолчанию 604800 (7 суток).
# PARSE_RESULT_HASH_TTL_SECONDS=604800

# Публичный URL веб-приложения (без / в конце) — для ссылок в письмах/Excel и абсолютных URL аватаров в API.
# PUBLIC_APP_URL="https://staging-app.example.com"

# За reverse proxy (nginx) с rate limit и корректным IP клиента: TRUST_PROXY=1
# TRUST_PROXY=1

# Лимит POST /api/auth/login с одного IP (окно в мс, макс. запросов за окно).
# AUTH_LOGIN_RATE_WINDOW_MS=900000
# AUTH_LOGIN_RATE_MAX=30

# Макс. размер файла аватара (байты). По умолчанию 2 МБ.
# AVATAR_MAX_BYTES=2097152
