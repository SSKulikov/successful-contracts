DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/AlternativaGames"

# Подпись JWT (обязательно в production). В dev допустимо не задавать — используется запасной секрет.
# JWT_SECRET="openssl rand -hex 32"
# Срок жизни access-токена (например 7d, 24h). По умолчанию: 7d
# JWT_EXPIRES_IN="7d"
# Origin фронта (Vite), без завершающего слэша. Несколько значений через запятую.
# Если не задано — API разрешает любой origin (удобно для локальной разработки).
# CORS_ORIGIN="http://localhost:5173"
# Optional. Kept for reference, not used in current runtime.
DATABASE_NAME="AlternativaGames"
# Optional. Used only by legacy YaGptService.
OAUTH_TOKEN=""
GIGA_CHAT_ACCESS_KEY=""
