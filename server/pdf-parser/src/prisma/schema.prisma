// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model contract {
  id                       Int      @id @default(autoincrement())
  supplier_name            String?
  supplier_inn             BigInt?  @db.UnsignedBigInt
  supplier_kpp             BigInt?  @db.UnsignedBigInt
  supplier_ogrn            BigInt?  @db.UnsignedBigInt
  supplier_bik             String?
  supplier_corr_account    String?
  supplier_payment_account String?
  supplier_email           String?
  supplier_phone           String?
  supplier_address         String?
  supplier_bank_name       String?

  customer_name            String?
  customer_inn             BigInt?  @db.UnsignedBigInt
  customer_kpp             BigInt?  @db.UnsignedBigInt
  customer_ogrn            BigInt?  @db.UnsignedBigInt
  customer_bik             String?
  customer_corr_account    String?
  customer_payment_account String?
  customer_email           String?
  customer_phone           String?
  customer_address         String?
  customer_bank_name       String?

  contract_number          String?
  contract_subject         String?
  item                     String?
  contract_sum             BigInt?  @db.UnsignedBigInt
  contract_currency        String?
  contract_date            String?
  contract_start_date      String?
  contract_end_date        String?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

/// Организации (tenant). Создаётся миграцией `20260413120000_add_companies_employees_auth_sessions`.
model Company {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  inn       String     @unique @db.VarChar(32)
  createdAt DateTime   @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.DateTime(0)
  employees Employee[]

  @@map("companies")
}

/// Сотрудники и администраторы компаний. `companyId` NULL — платформенный админ или legacy.
model Employee {
  id                  Int           @id @default(autoincrement())
  fullName            String        @map("full_name") @db.VarChar(255)
  email               String        @unique @db.VarChar(255)
  position            String        @db.VarChar(255)
  rolesJson           String        @map("roles_json") @db.Text
  passwordValue       String        @map("password_value") @db.VarChar(255)
  isTemporaryPassword Int           @default(1) @map("is_temporary_password") @db.TinyInt
  status              String        @default("Активен") @db.VarChar(32)
  createdAt           DateTime      @default(now()) @map("created_at") @db.DateTime(0)
  companyId           Int?          @map("company_id")
  deletedAt           DateTime?     @map("deleted_at") @db.DateTime(3)
  /// Имя файла в uploads/avatars (не полный URL).
  avatarUrl           String?       @map("avatar_url") @db.VarChar(512)
  company             Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  authSessions        AuthSession[]

  @@index([companyId])
  @@index([deletedAt])
  @@map("employees")
}

model AuthSession {
  token      String   @id @db.VarChar(255)
  employeeId Int      @map("employee_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(0)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("auth_sessions")
}
