# Copy these values into Docker hosting environment variables / secrets.
# Do not commit real secrets.

WEB_PORT=80

# Public frontend URL, without trailing slash.
PUBLIC_APP_URL=https://your-domain.example
CORS_ORIGIN=https://your-domain.example
TRUST_PROXY=1

# VPS MySQL.
DATABASE_URL=mysql://USER:PASSWORD@VPS_HOST:3306/docflow

# Auth.
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=7d

# Object Storage.
STORAGE_PROVIDER=s3
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET_RAW=contracts-raw-prod
S3_BUCKET_PROCESSED=contracts-processed-prod
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_UPLOAD_TTL_SEC=900
S3_PRESIGNED_DOWNLOAD_TTL_SEC=900

# Parser limits.
PARSER_MAX_FILE_MB=30
PARSER_JOB_TIMEOUT_MS=120000

# Optional cache.
# REDIS_URL=redis://redis-host:6379

# Optional LLM settings used by legacy parse-file flow.
LLM_PROVIDER=gigachat
# Temporary compatibility flag for GigaChat TLS chain in Docker.
# Prefer NODE_EXTRA_CA_CERTS with the proper CA bundle when available.
NODE_TLS_REJECT_UNAUTHORIZED=0
GIGA_CHAT_ACCESS_KEY=
OAUTH_TOKEN=
FOLDER_ID=
BEARER_TOKEN=
