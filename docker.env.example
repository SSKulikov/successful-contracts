# Скопируйте в `.env` в корне репозитория (рядом с docker-compose.yml).
# Docker Compose подставляет значения при `docker compose up`.

# MySQL
MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=pdf_parser
# Порт на **хосте** (снаружи Docker). 3307 по умолчанию — чтобы не конфликтовать с MySQL на хосте :3306.
# С DBeaver/CLI: localhost:3307 → пользователь root. Внутри compose сервис api ходит на mysql:3306.
MYSQL_PORT=3307

# Redis
REDIS_PORT=6379

# API: порт на **хосте** → контейнер слушает 3003 внутри. 3004 по умолчанию — чтобы не биться с локальным бэкендом на :3003.
# Фронт с хоста: VITE_API_URL=http://localhost:3004/api
API_PORT=3004

# Базовый URL фронта для ссылок и будущего CORS (см. docs/DEPLOY.md)
PUBLIC_APP_URL=http://localhost:5173
# Несколько origin через запятую (Vite :5173; частый dev — :3000).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Для доступа к фронту по IP (WSL Network и т.п.): см. CORS_ALLOW_LAN_ORIGINS в server `cors-config.ts`.
# CORS_ALLOW_LAN_ORIGINS=1

# Заготовка под JWT / подписи (сейчас в коде может не использоваться)
JWT_SECRET=change-me-in-production

# За reverse proxy с TLS: TRUST_PROXY=1 (пробросьте в сервис api в compose при необходимости)
# TRUST_PROXY=1

# Adminer (только с профилем tools): http://localhost:8080
ADMINER_PORT=8080

# --- Стенд: без моков на фронте ---
# В .env для Vite-сборки / dev: VITE_USE_MOCK_API=false

# --- Smoke e2e (из хоста: cd server/pdf-parser && npm run test:e2e) ---
# STAGING_API_URL=http://localhost:3004/api
# STAGING_EMAIL=user@company.ru
# STAGING_PASSWORD=...
# Опционально: второй сотрудник той же компании (не админ) — проверка PATCH чужого черновика → 403
# STAGING_EMAIL_B=other@company.ru
# STAGING_PASSWORD_B=...
# Опционально: PING Redis (URL как у API, с хоста часто redis://127.0.0.1:6379)
# STAGING_REDIS_URL=redis://127.0.0.1:6379
# Для полного цикла в test:e2e под платформенным админом — компания документа и id согласующего:
# STAGING_COMPANY_ID=1
# STAGING_APPROVER_EMPLOYEE_ID=2
