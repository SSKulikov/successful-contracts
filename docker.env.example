# Скопируйте в `.env` в корне репозитория (рядом с docker-compose.yml).
# Docker Compose подставляет значения при `docker compose up`.

# MySQL
MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=pdf_parser
# Порт на **хосте** (снаружи Docker). 3307 по умолчанию — чтобы не конфликтовать с MySQL на хосте :3306.
# С DBeaver/CLI: localhost:3307 → пользователь root. Внутри compose сервис api ходит на mysql:3306.
MYSQL_PORT=3307

# Redis
REDIS_PORT=6379

# API: порт на **хосте** → контейнер слушает 3003 внутри. 3004 по умолчанию — чтобы не биться с локальным бэкендом на :3003.
# Фронт с хоста: VITE_API_URL=http://localhost:3004/api
API_PORT=3004

# Базовый URL фронта для ссылок и будущего CORS (см. docs/DEPLOY.md)
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Заготовка под JWT / подписи (сейчас в коде может не использоваться)
JWT_SECRET=change-me-in-production

# Adminer (только с профилем tools): http://localhost:8080
ADMINER_PORT=8080
